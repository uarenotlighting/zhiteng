NODE_ENV=development
PORT=3000
API_PREFIX=v1

# Local Postgres (docker compose)
DATABASE_URL=postgresql://zhiteng:zhiteng@127.0.0.1:5432/zhiteng?schema=public

# Local Redis
REDIS_URL=redis://127.0.0.1:6379

# JWT — change before any shared/staging environment
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Development auth: allow mock platform exchange without real WeChat credentials
AUTH_DEV_MOCK_ENABLED=true

# AES transport (生产 NODE_ENV=production 时强制开启，不可关闭)
TRANSPORT_ENCRYPTION=false

# Optional real WeChat mini program credentials (leave empty in local mock mode)
WEIXIN_APP_ID=
WEIXIN_APP_SECRET=

# CORS for local mini program / H5 tooling
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
