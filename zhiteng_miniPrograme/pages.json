{
  "easycom": {
    "custom": {
      "^t-(.*)": "@/uni_modules/tdesign-uniapp/components/$1/$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "知疼"
      }
    },
    {
      "path": "pages/history/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "疼痛记录"
      }
    },
    {
      "path": "pages/trends/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "变化趋势"
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "我的"
      }
    },
    {
      "path": "pages/onboarding/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "认识知疼"
      }
    },
    {
      "path": "pages/login/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "登录知疼"
      }
    }
  ],
  "subPackages": [
    {
      "root": "packages/locate",
      "pages": [
        {
          "path": "pages/record/index",
          "style": {
            "navigationStyle": "custom",
            "navigationBarTitleText": "疼痛记录"
          }
        }
      ]
    }
  ],
  "preloadRule": {
    "pages/index/index": {
      "network": "all",
      "packages": ["packages/locate"]
    }
  },
  "globalStyle": {
    "navigationStyle": "custom",
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "知疼",
    "navigationBarBackgroundColor": "#FCFCFC",
    "backgroundColor": "#FCFCFC"
  }
}
